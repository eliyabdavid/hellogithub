# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheet URL containing apartment information
SHEET_LINK=https://docs.google.com/spreadsheets/d/your_sheet_id_here

# Gmail accounts to monitor (up to 4)
GMAIL_ACCOUNT_1=host1@gmail.com
GMAIL_ACCOUNT_2=host2@gmail.com
GMAIL_ACCOUNT_3=host3@gmail.com
GMAIL_ACCOUNT_4=host4@gmail.com

# Path to Google service account credentials JSON (for Sheets access)
GOOGLE_CREDENTIALS_PATH=credentials.json
