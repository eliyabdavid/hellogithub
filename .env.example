# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheet URL containing apartment information
SHEET_LINK=https://docs.google.com/spreadsheets/d/your_sheet_id_here

# Gmail accounts to monitor (comma-separated)
GMAIL_ACCOUNTS=host1@gmail.com,host2@gmail.com

# Email to receive ALERT_HOST complaint notifications (optional, defaults to first Gmail)
ALERT_EMAIL=

# How often to check for new messages (seconds)
POLL_INTERVAL=60
